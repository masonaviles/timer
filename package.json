{
  "name": "@masonaviles/cuestack",
  "version": "0.1.0",
  "description": "White-label, themeable, step-by-step cue timer. Framework-free core + Preact view layer, shippable as a package.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Mason Aviles",
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "import": "./dist/player.js"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js"
    },
    "./ads": {
      "types": "./dist/ads/index.d.ts",
      "import": "./dist/ads/index.js"
    },
    "./styles.css": "./dist/view/styles.css"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prepublishOnly": "npm run check && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "nanoid": "^5.0.0"
  },
  "peerDependencies": {
    "preact": ">=10"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@preact/preset-vite": "^2.9.0",
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^2.1.0",
    "axe-core": "^4.12.0",
    "jsdom": "^25.0.0",
    "preact": "^10.24.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
